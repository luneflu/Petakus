---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaFloat from "../components/ui/WaFloat.astro";
import Navbar from "../components/ui/Navbar.astro";
import MobileNav from "../components/ui/MobileNav.astro";
import Hero from "../components/sections/Hero.astro";
import Profil from "../components/sections/Profil.astro";
import ProdukLayanan from "../components/sections/ProdukLayanan.astro";
import Galeri from "../components/sections/Galeri.astro";
import Mitra from "../components/sections/Mitra.astro";
import Support from "../components/sections/Support.astro";
import Lokasi from "../components/sections/Lokasi.astro";
import Kontak from "../components/sections/Kontak.astro";
import Footer from "../components/ui/Footer.astro";
import Lightbox from "../components/ui/Lightbox.astro";
---

<BaseLayout>
    <!-- ===== WHATSAPP FLOATING BUTTON ===== -->
    <WaFloat />

    <!-- NAVBAR -->
    <Navbar />

    <!-- MOBILE NAV OVERLAY -->
    <MobileNav />

    <!-- HERO SECTION -->
    <Hero />

    <!-- PROFIL PERUSAHAAN -->
    <Profil />

    <!-- PRODUK & LAYANAN -->
    <ProdukLayanan />

    <!-- GALERI -->
    <Galeri />

    <!-- MITRA & PARTNER -->
    <Mitra />

    <!-- SUPPORT -->
    <Support />

    <!-- LOKASI -->
    <Lokasi />

    <!-- KONTAK -->
    <Kontak />

    <!-- FOOTER -->
    <Footer />

    <!-- LIGHTBOX -->
    <Lightbox />
</BaseLayout>
