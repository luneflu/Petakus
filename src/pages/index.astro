---
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "../styles/global.css";
import "bootstrap/dist/css/bootstrap.min.css";
import "@fortawesome/fontawesome-free/css/all.min.css";
import "aos/dist/aos.css";
import "swiper/swiper-bundle.css";
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta
            property="og:title"
            content="PT Pesona Lintang Kemukus | Sewa Kendaraan & Alat Berat Corporate & Tol"
        />
        <meta
            property="og:description"
            content="PT Pesona Lintang Kemukus menyediakan layanan sewa kendaraan dan alat berat untuk korporasi dan jalan tol di seluruh Indonesia."
        />
        <meta
            property="og:image"
            content="https://pesonalintangkemukus.com/image/logo.webp"
        />
        <meta property="og:url" content="https://pesonalintangkemukus.com" />
        <meta
            name="google-site-verification"
            content="CxbyEpwBOtyahNMGEtO5oJ2dcK2mNU6d29gAW93o3-4"
        />
        <meta property="og:type" content="company" />
        <meta
            name="description"
            content="PT Pesona Lintang Kemukus menyediakan layanan sewa kendaraan dan alat berat untuk korporasi dan jalan tol di seluruh Indonesia."
        />
        <title>
            PT Pesona Lintang Kemukus | Sewa Kendaraan & Alat Berat Corporate &
            Tol
        </title>

        <link rel="icon" href="image/logo.webp" type="image/webp" />
    </head>

    <body>
        <!-- MAIN CONTENT -->
        <div class="main-content visible" id="mainContent" style="opacity: 1;">
            <!-- ===== WHATSAPP FLOATING BUTTON ===== -->
            <div class="whatsapp-float" id="waFloat">
                <div class="wa-tooltip">Hubungi kami via WhatsApp</div>
                <a
                    href="https://wa.me/6281331795070?text=Halo%20PT%20Pesona%20Lintang%20Kemukus%2C%20saya%20ingin%20menanyakan%20sewa%20kendaraan"
                    class="wa-button"
                    target="_blank"
                    aria-label="WhatsApp"
                >
                    <span class="pulse-ring"></span>
                    <span class="pulse-ring"></span>
                    <i class="fab fa-whatsapp"></i>
                    <span class="wa-badge">1</span>
                </a>
            </div>

            <!-- NAVBAR -->
            <nav
                class="navbar navbar-expand-lg navbar-dark fixed-top"
                id="mainNavbar"
            >
                <div class="container">
                    <a class="navbar-brand d-flex align-items-center" href="#">
                        <img
                            src="/image/logo.webp"
                            class="brand-logo-img"
                            alt="Logo"
                            width="45"
                            height="45"
                        />
                        <span class="brand-text">PESONA LINTANG KEMUKUS</span>
                    </a>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a
                                    class="nav-link"
                                    href="#home"
                                    data-section="home">Beranda</a
                                >
                            </li>
                            <li class="nav-item">
                                <a
                                    class="nav-link"
                                    href="#profil"
                                    data-section="profil">Profil Perusahaan</a
                                >
                            </li>
                            <li class="nav-item">
                                <a
                                    class="nav-link"
                                    href="#produk-layanan"
                                    data-section="produk-layanan"
                                    >Produk & Layanan</a
                                >
                            </li>
                            <li class="nav-item">
                                <a
                                    class="nav-link"
                                    href="#galeri"
                                    data-section="galeri">Galeri</a
                                >
                            </li>
                            <li class="nav-item">
                                <a
                                    class="nav-link"
                                    href="#mitra"
                                    data-section="mitra">Partner</a
                                >
                            </li>
                            <li class="nav-item">
                                <a
                                    class="nav-link"
                                    href="#support"
                                    data-section="support">Support</a
                                >
                            </li>
                        </ul>
                        <a href="#kontak" class="btn btn-primary-blue ms-lg-3"
                            >Hubungi Kami</a
                        >
                    </div>
                    <button
                        class="mobile-menu-btn"
                        id="mobileMenuBtn"
                        aria-label="Menu"
                    >
                        <span></span><span></span><span></span>
                    </button>
                </div>
            </nav>

            <!-- MOBILE NAV OVERLAY -->
            <div class="mobile-nav-overlay" id="mobileNavOverlay">
                <div class="mobile-nav-header">
                    <div class="brand-info">
                        <img
                            src="/image/logo.webp"
                            alt="Logo"
                            width="66"
                            height="38"
                            onerror="this.setAttribute('src', 'https://placehold.co/66x38/2563eb/white?text=PLK')"
                        />
                        <span>PESONA LINTANG<br />KEMUKUS</span>
                    </div>
                    <button
                        class="mobile-nav-close"
                        id="mobileNavClose"
                        aria-label="Tutup Menu"
                        ><i class="fas fa-times"></i></button
                    >
                </div>
                <div class="mobile-nav-links">
                    <a href="#home" class="mobile-nav-link" data-section="home"
                        ><span class="nav-icon"
                            ><i class="fas fa-home"></i></span
                        >Beranda<i class="fas fa-chevron-right nav-arrow"
                        ></i></a
                    >
                    <a
                        href="#profil"
                        class="mobile-nav-link"
                        data-section="profil"
                        ><span class="nav-icon"
                            ><i class="fas fa-building"></i></span
                        >Profil Perusahaan<i
                            class="fas fa-chevron-right nav-arrow"></i></a
                    >
                    <a
                        href="#produk-layanan"
                        class="mobile-nav-link"
                        data-section="produk-layanan"
                        ><span class="nav-icon"
                            ><i class="fas fa-truck"></i></span
                        >Produk & Layanan<i
                            class="fas fa-chevron-right nav-arrow"></i></a
                    >
                    <a
                        href="#galeri"
                        class="mobile-nav-link"
                        data-section="galeri"
                        ><span class="nav-icon"
                            ><i class="fas fa-images"></i></span
                        >Galeri<i class="fas fa-chevron-right nav-arrow"></i></a
                    >
                    <a
                        href="#mitra"
                        class="mobile-nav-link"
                        data-section="mitra"
                        ><span class="nav-icon"
                            ><i class="fas fa-handshake"></i></span
                        >Partner & Support<i
                            class="fas fa-chevron-right nav-arrow"></i></a
                    >
                    <a
                        href="#support"
                        class="mobile-nav-link"
                        data-section="support"
                        ><span class="nav-icon"
                            ><i class="fas fa-headset"></i></span
                        >Support<i class="fas fa-chevron-right nav-arrow"
                        ></i></a
                    >
                </div>
                <div class="mobile-nav-footer">
                    <a
                        href="https://wa.me/6285156262804?text=Halo%20PT%20Pesona%20Lintang%20Kemukus%2C%20saya%20ingin%20menanyakan%20sewa%20kendaraan"
                        class="btn-cta"
                        id="mobileCta"
                        ><i class="fab fa-whatsapp"></i> Hubungi Kami</a
                    >
                    <div class="social-row">
                        <a
                            href="https://www.instagram.com/pesonalintangkemukus/"
                            class="text-primary-blue me-3 fs-5"
                            aria-label="Instagram"
                            ><i class="fab fa-instagram"></i></a
                        >
                        <a
                            href="https://www.linkedin.com/in/pt-pesona-lintang-kemukus-197165270/"
                            class="text-primary-blue me-3 fs-5"
                            aria-label="LinkedIn"
                            ><i class="fab fa-linkedin-in"></i></a
                        >
                    </div>
                </div>
            </div>

            <!-- HERO SECTION -->
            <section id="home" class="hero-section">
                <video
                    class="hero-video-background"
                    autoplay
                    loop
                    playsinline
                    muted
                    id="heroVideo"
                >
                    <source src="/video/bg2.mp4" type="video/mp4" />
                    <track
                        kind="captions"
                        src=""
                        srclang="id"
                        label="Indonesian"
                    />
                </video>
                <div class="sound-indicator" id="soundIndicator">
                    <div class="sound-badge">
                        <i class="fas fa-volume-mute" id="soundIcon"></i>
                        <span id="soundText">Suara Mati</span>
                    </div>
                </div>
                <div class="swiper hero-swiper">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide">
                            <div class="hero-slide">
                                <div class="container py-5 my-4">
                                    <div
                                        class="row align-items-center min-vh-75"
                                    >
                                        <div
                                            class="col-lg-7 text-white mb-5 mb-lg-0"
                                        >
                                            <h1
                                                class="display-4 fw-bold mb-4 slide-content"
                                            >
                                                Your Best <span
                                                    style="color: #60a5fa;"
                                                    >Rent Car</span
                                                > Services
                                            </h1>
                                            <p
                                                class="lead mb-4 opacity-90 slide-content"
                                                style="animation-delay: 0.1s;"
                                            >
                                                PT Pesona Lintang Kemukus
                                                (PETAKUS) merupakan perusahaan
                                                yang bergerak di bidang penyedia
                                                jasa sewa kendaraan besar maupun
                                                kecil yang dikhususkan untuk
                                                corporate.
                                            </p>
                                        </div>
                                        <div class="col-lg-5 text-center">
                                            <div class="hero-logo-wrapper">
                                                <img
                                                    src="/image/logo.webp"
                                                    alt="PT Pesona Lintang Kemukus"
                                                    width="380"
                                                    height="220"
                                                    {...{ fetchpriority: "high" }}
                                                />
                                            </div>
                                            <div class="hero-caption">
                                                <p class="h5-style">
                                                    Corporate Cars Specialist
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="swiper-slide">
                            <div class="hero-slide">
                                <div class="container py-5 my-4">
                                    <div
                                        class="row align-items-center min-vh-75 justify-content-center text-center"
                                    >
                                        <div class="col-lg-8 text-white">
                                            <div class="hero-logo-wrapper mb-4">
                                                <img
                                                    src="/image/logo.webp"
                                                    alt="PT Pesona Lintang Kemukus"
                                                    style="max-width: 200px;"
                                                    width="200"
                                                    height="116"
                                                />
                                            </div>
                                            <div class="slide-content">
                                                <h1 class="slogan-text">
                                                    "DRIVING YOUR BUSINESS
                                                    FORWARD, TOGETHER"
                                                </h1>
                                                <div class="hero-caption">
                                                    <p class="h5-style">
                                                        #KamiAdaUntukAnda
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div
                        class="hero-swiper-button-prev"
                        aria-label="Previous slide"
                    >
                        <i class="fas fa-chevron-left"></i>
                    </div>
                    <div
                        class="hero-swiper-button-next"
                        aria-label="Next slide"
                    >
                        <i class="fas fa-chevron-right"></i>
                    </div>
                    <div class="hero-pagination">
                        <div class="dot" data-index="0"></div>
                        <div class="dot" data-index="1"></div>
                    </div>
                </div>
            </section>

            <!-- PROFIL PERUSAHAAN -->
            <section id="profil" class="py-5 bg-soft-blue">
                <div class="container py-4">
                    <div class="row g-5 align-items-center mb-5">
                        <div class="col-lg-6" data-aos="fade-right">
                            <h2 class="section-title mt-3 fs-1">
                                PT Pesona Lintang Kemukus
                            </h2>
                            <p class="mt-3 fs-5 text-secondary">
                                PT Pesona Lintang Kemukus hadir sebagai mitra
                                terpercaya yang profesional dalam menyediakan
                                kendaraan operasional yang dikhususkan untuk
                                perusahaan, dengan standar layanan terbaik di
                                seluruh wilayah Indonesia. Kami berkomitmen
                                untuk mendukung efisiensi operasional perusahaan
                                Anda melalui penyediaan armada yang prima,
                                sistem manajemen transportasi yang terintegrasi,
                                serta dukungan layanan yang terbaik.
                            </p>
                            <div class="row mt-4">
                                <div class="col-md-6 mb-3">
                                    <i
                                        class="fas fa-check-circle text-primary-blue me-2"
                                        aria-hidden="true"></i> 500+ Unit Kendaraan
                                    & Alat Berat
                                </div>
                                <div class="col-md-6 mb-3">
                                    <i
                                        class="fas fa-check-circle text-primary-blue me-2"
                                        aria-hidden="true"></i> 100+ Mitra Corporate
                                    Aktif
                                </div>
                                <div class="col-md-6 mb-3">
                                    <i
                                        class="fas fa-check-circle text-primary-blue me-2"
                                        aria-hidden="true"></i> 24/7 Emergency Support
                                </div>
                                <div class="col-md-6 mb-3">
                                    <i
                                        class="fas fa-check-circle text-primary-blue me-2"
                                        aria-hidden="true"></i> ISO & K3 Bersertifikat
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="text-center mb-4">
                        <h2 class="section-title">Visi & Misi</h2>
                        <p class="text-muted">
                            Komitmen kami untuk menjadi mitra terpercaya
                        </p>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6" data-aos="fade-right">
                            <div class="visi-misi-card h-100 shadow-sm">
                                <i
                                    class="fas fa-eye fa-3x text-primary-blue mb-3"
                                ></i>
                                <h3 class="fw-bold">Visi</h3>
                                <p class="fs-5">
                                    Penyambung akses membangun Indonesia
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6" data-aos="fade-left">
                            <div class="visi-misi-card h-100 shadow-sm">
                                <i
                                    class="fas fa-bullseye fa-3x text-primary-blue mb-3"
                                ></i>
                                <h3 class="fw-bold">Misi</h3>
                                <ul class="list-unstyled mt-2">
                                    <li class="mb-2">
                                        <i
                                            class="fas fa-check-circle text-primary-blue me-2"
                                            aria-hidden="true"></i> Membangun kerjasama
                                        dengan pihak terkait
                                    </li>
                                    <li class="mb-2">
                                        <i
                                            class="fas fa-check-circle text-primary-blue me-2"
                                            aria-hidden="true"></i> Menyediakan fasilitas
                                        terbaik
                                    </li>
                                    <li class="mb-2">
                                        <i
                                            class="fas fa-check-circle text-primary-blue me-2"
                                            aria-hidden="true"></i> Menyediakan Kendaraan
                                        terbaik
                                    </li>
                                    <li class="mb-2">
                                        <i
                                            class="fas fa-check-circle text-primary-blue me-2"
                                            aria-hidden="true"></i> Memberikan pelayanan
                                        prima
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- PRODUK & LAYANAN -->
            <section id="produk-layanan" class="py-5">
                <div class="container">
                    <div class="text-center mb-5">
                        <h2 class="section-title">Produk & Layanan</h2>
                        <p class="text-muted w-75 mx-auto">
                            Solusi lengkap kebutuhan operasional dan proyek Anda
                        </p>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6 col-lg-3">
                            <div class="produk-item">
                                <div class="produk-icon mx-auto">
                                    <i
                                        class="fas fa-charging-station fa-3x text-primary-blue"
                                    ></i>
                                </div>
                                <h3 class="h5 fw-bold">Mobil Listrik</h3>
                                <p class="text-muted">
                                    Ramah lingkungan, efisien, teknologi modern
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <div class="produk-item">
                                <div class="produk-icon mx-auto">
                                    <i
                                        class="fas fa-car fa-3x text-primary-blue"
                                    ></i>
                                </div>
                                <h3 class="h5 fw-bold">Kendaraan Kecil</h3>
                                <p class="text-muted">
                                    Sedan, SUV, MPV untuk mobilitas eksekutif
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <div class="produk-item">
                                <div class="produk-icon mx-auto">
                                    <i
                                        class="fas fa-truck fa-3x text-primary-blue"
                                    ></i>
                                </div>
                                <h3 class="h5 fw-bold">Kendaraan Besar</h3>
                                <p class="text-muted">
                                    Bus, truk box, tronton untuk logistik
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <div class="produk-item">
                                <div class="produk-icon mx-auto">
                                    <i
                                        class="fas fa-hard-hat fa-3x text-primary-blue"
                                    ></i>
                                </div>
                                <h3 class="h5 fw-bold">Alat Berat</h3>
                                <p class="text-muted">
                                    Excavator, bulldozer, crane untuk proyek tol
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="text-center mt-5">
                        <a href="#kontak" class="btn btn-primary-blue"
                            >Konsultasi Kebutuhan <i
                                class="fas fa-arrow-right ms-2"></i></a
                        >
                    </div>
                </div>
            </section>

            <!-- GALERI -->
            <section id="galeri" class="py-5 bg-soft-blue">
                <div class="container-fluid px-0">
                    <div class="text-center mb-4" data-aos="fade-up">
                        <h2 class="section-title">Galeri Kendaraan</h2>
                        <p class="text-muted mt-3">
                            Koleksi kendaraan unggulan kami
                        </p>
                    </div>
                    <div
                        class="galeri-tabs"
                        data-aos="fade-up"
                        data-aos-delay="80"
                    >
                        <button class="galeri-tab-btn active" data-filter="tol"
                            ><i class="fas fa-road"></i> Kendaraan Layanan Jalan Tol</button
                        >
                        <button class="galeri-tab-btn" data-filter="ev"
                            ><i class="fas fa-charging-station"></i> Mobil Listrik</button
                        >
                        <button class="galeri-tab-btn" data-filter="kecil"
                            ><i class="fas fa-car"></i> Kendaraan Kecil</button
                        >
                        <button class="galeri-tab-btn" data-filter="besar"
                            ><i class="fas fa-truck"></i> Kendaraan Besar</button
                        >
                    </div>
                    <div
                        class="galeri-grid"
                        data-aos="fade-up"
                        data-aos-delay="150"
                    >
                        <!-- Mobil Listrik -->
                        <div
                            class="galeri-item"
                            data-category="ev"
                            data-title="Hyundai Ioniq 5"
                            data-desc="SUV listrik premium, jarak tempuh 450km"
                        >
                            <img
                                loading="lazy"
                                src="/image/ioniq5.webp"
                                alt="Hyundai Ioniq 5"
                                width="600"
                                height="450"
                            />
                            <div class="galeri-item-overlay">
                                <span class="item-badge">EV</span>
                                <p class="item-title">Hyundai Ioniq 5</p>
                                <p class="item-desc">SUV listrik premium</p>
                            </div>
                        </div>
                        <div
                            class="galeri-item"
                            data-category="ev"
                            data-title="BYD Atto 3"
                            data-desc="Desain futuristik, baterai blade technology"
                        >
                            <img
                                loading="lazy"
                                src="/image/atto3.webp"
                                alt="BYD Atto 3"
                                width="600"
                                height="450"
                            />
                            <div class="galeri-item-overlay">
                                <span class="item-badge">EV</span>
                                <p class="item-title">BYD Atto 3</p>
                                <p class="item-desc">Desain futuristik</p>
                            </div>
                        </div>
                        <div
                            class="galeri-item"
                            data-category="ev"
                            data-title="DFSK Gelora"
                            data-desc="Desain futuristik, baterai blade technology"
                        >
                            <img
                                loading="lazy"
                                src="/image/ev 1.webp"
                                alt="DFSK Gelora"
                                width="600"
                                height="450"
                            />
                            <div class="galeri-item-overlay">
                                <span class="item-badge">EV</span>
                                <p class="item-title">DFSK Gelora</p>
                                <p class="item-desc">Desain futuristik</p>
                            </div>
                        </div>
                        <!-- Kendaraan Kecil -->
                        <div
                            class="galeri-item"
                            data-category="kecil"
                            data-title="Toyota Hilux Rangga"
                            data-desc="Shuttle Pickup"
                        >
                            <img
                                loading="lazy"
                                src="/image/kecil 1.webp"
                                alt="Toyota Hilux Rangga"
                                width="600"
                                height="450"
                            />
                            <div class="galeri-item-overlay">
                                <span class="item-badge">MPV</span>
                                <p class="item-title">Toyota Hilux Rangga</p>
                                <p class="item-desc">Shuttle Pickup</p>
                            </div>
                        </div>
                        <div
                            class="galeri-item"
                            data-category="kecil"
                            data-title="Toyota Hilux Double Cabin"
                            data-desc="Mobil Customer Service"
                        >
                            <img
                                loading="lazy"
                                src="/image/kecil 2.webp"
                                alt="Toyota Hilux Double Cabin"
                                width="600"
                                height="450"
                            />
                            <div class="galeri-item-overlay">
                                <span class="item-badge">SUV</span>
                                <p class="item-title">
                                    Toyota Hilux Double Cabin
                                </p>
                                <p class="item-desc">Mobil Customer Service</p>
                            </div>
                        </div>
                        <div
                            class="galeri-item"
                            data-category="kecil"
                            data-title="Toyota New Vios"
                            data-desc="Patroli Jalan Raya"
                        >
                            <img
                                loading="lazy"
                                src="/image/kecil 3.webp"
                                alt="Toyota New Vios"
                                width="600"
                                height="450"
                            />
                            <div class="galeri-item-overlay">
                                <span class="item-badge">MPV</span>
                                <p class="item-title">Toyota New Vios</p>
                                <p class="item-desc">Patroli Jalan Raya</p>
                            </div>
                        </div>
                        <div
                            class="galeri-item"
                            data-category="kecil"
                            data-title="Daihatsu New Xenia"
                            data-desc="Kendaraan Operasional"
                        >
                            <img
