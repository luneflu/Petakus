                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="produk-item">
                            <div class="produk-icon mx-auto"><i class="fas fa-hard-hat fa-3x text-primary-blue"></i>
                            </div>
                            <h5 class="fw-bold">Alat Berat</h5>
                            <p class="text-muted">Excavator, bulldozer, crane untuk proyek tol</p>
