                                        </div>
                                        <div class="hero-caption">
                                            <p class="h5-style">Corporate Cars Specialist</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="hero-slide">
                            <div class="container py-5 my-4">
                                <div class="row align-items-center min-vh-75 justify-content-center text-center">
                                    <div class="col-lg-8 text-white">
                                        <div class="hero-logo-wrapper mb-4">
                                            <img src="/image/logo.webp" alt="PT Pesona Lintang Kemukus"
                                                style="max-width: 200px;" width="200" height="116">  
                                        </div>
                                        <div class="slide-content">
                                            <h1 class="slogan-text">"DRIVING YOUR BUSINESS FORWARD, TOGETHER"</h1>
                                            <div class="hero-caption">
                                                <p class="h5-style">#KamiAdaUntukAnda</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="hero-swiper-button-prev"><i class="fas fa-chevron-left"></i></div>
                <div class="hero-swiper-button-next"><i class="fas fa-chevron-right"></i></div>
                <div class="hero-pagination">
                    <div class="dot" data-index="0"></div>
                    <div class="dot" data-index="1"></div>
                </div>
            </div>
        </section>

        <!-- PROFIL PERUSAHAAN -->
        <section id="profil" class="py-5 bg-soft-blue">
            <div class="container py-4">
                <div class="row g-5 align-items-center mb-5">
                    <div class="col-lg-6" data-aos="fade-right">
                        <h2 class="section-title mt-3 fs-1">PT Pesona Lintang Kemukus</h2>
                        <p class="mt-3 fs-5 text-secondary">PT Pesona Lintang Kemukus hadir sebagai mitra terpercaya
                            yang profesional dalam menyediakan kendaraan operasional yang dikhususkan untuk perusahaan,
                            dengan standar layanan terbaik di seluruh wilayah Indonesia. Kami berkomitmen untuk
                            mendukung efisiensi operasional perusahaan Anda melalui penyediaan armada yang prima, sistem
                            manajemen transportasi yang terintegrasi, serta dukungan layanan yang terbaik.</p>
                        <div class="row mt-4">
                            <div class="col-md-6 mb-3"><i class="fas fa-check-circle text-primary-blue me-2"></i> 500+
                                Unit Kendaraan & Alat Berat</div>
                            <div class="col-md-6 mb-3"><i class="fas fa-check-circle text-primary-blue me-2"></i> 100+
                                Mitra Corporate Aktif</div>
                            <div class="col-md-6 mb-3"><i class="fas fa-check-circle text-primary-blue me-2"></i> 24/7
                                Emergency Support</div>
