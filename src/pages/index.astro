                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="produk-item">
                            <div class="produk-icon mx-auto"><i class="fas fa-car fa-3x text-primary-blue"></i></div>
                            <h5 class="fw-bold">Kendaraan Kecil</h5>
                            <p class="text-muted">Sedan, SUV, MPV untuk mobilitas eksekutif</p>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="produk-item">
                            <div class="produk-icon mx-auto"><i class="fas fa-truck fa-3x text-primary-blue"></i></div>
