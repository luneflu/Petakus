            <div class="container-fluid px-0">
                <div class="text-center mb-4" data-aos="fade-up">
                    <h2 class="section-title">Galeri Kendaraan</h2>
                    <p class="text-muted mt-3">Koleksi kendaraan unggulan kami</p>
                </div>
                <div class="galeri-tabs" data-aos="fade-up" data-aos-delay="80">
                    <button class="galeri-tab-btn active" data-filter="tol"><i class="fas fa-road"></i> Kendaraan
                        Layanan Jalan Tol</button>
                    <button class="galeri-tab-btn " data-filter="ev"><i class="fas fa-charging-station"></i> Mobil
                        Listrik</button>
                    <button class="galeri-tab-btn" data-filter="kecil"><i class="fas fa-car"></i> Kendaraan
                        Kecil</button>
                    <button class="galeri-tab-btn" data-filter="besar"><i class="fas fa-truck"></i> Kendaraan
                        Besar</button>

                </div>
                <div class="galeri-grid" data-aos="fade-up" data-aos-delay="150">
                    <!-- Mobil Listrik -->
                    <div class="galeri-item" data-category="ev" data-title="Hyundai Ioniq 5"
                        data-desc="SUV listrik premium, jarak tempuh 450km"><img loading="lazy" src="/image/ioniq5.webp"
                            alt="Hyundai Ioniq 5">
