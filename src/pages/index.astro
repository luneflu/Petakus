                        <li class="nav-item"><a class="nav-link" href="#galeri" data-section="galeri">Galeri</a></li>
                        <li class="nav-item"><a class="nav-link" href="#mitra" data-section="mitra">Partner</a></li>
                        <li class="nav-item"><a class="nav-link" href="#support" data-section="support">Support</a></li>
                    </ul>
                    <a href="#kontak" class="btn btn-primary-blue ms-lg-3">Hubungi Kami</a>
                </div>
                <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </nav>

        <!-- MOBILE NAV OVERLAY -->
        <div class="mobile-nav-overlay" id="mobileNavOverlay">
            <div class="mobile-nav-header">
                <div class="brand-info">
                    <img src="/image/logo.webp" alt="Logo" width="38" height="38"
                        onerror="this.src='https://placehold.co/38x38/2563eb/white?text=PLK'">
                    <span>PESONA LINTANG<br>KEMUKUS</span>
                </div>
                <button class="mobile-nav-close" id="mobileNavClose" aria-label="Tutup Menu"><i class="fas fa-times"></i></button>
            </div>
            <div class="mobile-nav-links">
                <a href="#home" class="mobile-nav-link" data-section="home"><span class="nav-icon"><i
                            class="fas fa-home"></i></span>Beranda<i class="fas fa-chevron-right nav-arrow"></i></a>
                <a href="#profil" class="mobile-nav-link" data-section="profil"><span class="nav-icon"><i
                            class="fas fa-building"></i></span>Profil Perusahaan<i
                        class="fas fa-chevron-right nav-arrow"></i></a>
                <a href="#produk-layanan" class="mobile-nav-link" data-section="produk-layanan"><span
                        class="nav-icon"><i class="fas fa-truck"></i></span>Produk & Layanan<i
                        class="fas fa-chevron-right nav-arrow"></i></a>
                <a href="#galeri" class="mobile-nav-link" data-section="galeri"><span class="nav-icon"><i
                            class="fas fa-images"></i></span>Galeri<i class="fas fa-chevron-right nav-arrow"></i></a>
                <a href="#mitra" class="mobile-nav-link" data-section="mitra"><span class="nav-icon"><i
                            class="fas fa-handshake"></i></span>Partner & Support<i
                        class="fas fa-chevron-right nav-arrow"></i></a>
                <a href="#support" class="mobile-nav-link" data-section="support"><span class="nav-icon"><i
                            class="fas fa-headset"></i></span>Support<i class="fas fa-chevron-right nav-arrow"></i></a>
            </div>
            <div class="mobile-nav-footer">
                <a href="https://wa.me/6285156262804?text=Halo%20PT%20Pesona%20Lintang%20Kemukus%2C%20saya%20ingin%20menanyakan%20sewa%20kendaraan"
                    class="btn-cta" id="mobileCta"><i class="fab fa-whatsapp"></i> Hubungi Kami</a>
                <div class="social-row">
                    <a href="https://www.instagram.com/pesonalintangkemukus/" class="text-primary-blue me-3 fs-5" aria-label="Instagram"><i
                            class="fab fa-instagram"></i></a>
                    <a href="https://www.linkedin.com/in/pt-pesona-lintang-kemukus-197165270/"
                        class="text-primary-blue me-3 fs-5" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>

                </div>
            </div>
        </div>

        <!-- HERO SECTION -->
        <section id="home" class="hero-section">
            <video class="hero-video-background" autoplay loop playsinline muted id="heroVideo">
                <source src="/video/bg2.mp4" type="video/mp4">
            </video>
            <div class="sound-indicator" id="soundIndicator">
                <div class="sound-badge">
                    <i class="fas fa-volume-mute" id="soundIcon"></i>
                    <span id="soundText">Suara Mati</span>
                </div>
            </div>
