                <div class="swiper-wrapper">
                    <div class="swiper-slide">
                        <div class="hero-slide">
                            <div class="container py-5 my-4">
                                <div class="row align-items-center min-vh-75">
                                    <div class="col-lg-7 text-white mb-5 mb-lg-0">
                                        <h1 class="display-4 fw-bold mb-4 slide-content">Your Best <span
                                                style="color: #60a5fa;">Rent Car</span> Services</h1>
                                        <p class="lead mb-4 opacity-90 slide-content" style="animation-delay: 0.1s;">PT
                                            Pesona Lintang Kemukus (PETAKUS) merupakan perusahaan yang bergerak di
                                            bidang penyedia jasa sewa kendaraan besar maupun kecil yang dikhususkan
