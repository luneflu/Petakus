                </div>
                <div class="text-center mb-4">
                    <h2 class="section-title">Visi & Misi</h2>
                    <p class="text-muted">Komitmen kami untuk menjadi mitra terpercaya</p>
                </div>
                <div class="row g-4">
                    <div class="col-md-6" data-aos="fade-right">
                        <div class="visi-misi-card h-100 shadow-sm">
                            <i class="fas fa-eye fa-3x text-primary-blue mb-3"></i>
                            <h3 class="fw-bold">Visi</h3>
                            <p class="fs-5">Penyambung akses membangun Indonesia</p>
                        </div>
                    </div>
                    <div class="col-md-6" data-aos="fade-left">
                        <div class="visi-misi-card h-100 shadow-sm">
                            <i class="fas fa-bullseye fa-3x text-primary-blue mb-3"></i>
                            <h3 class="fw-bold">Misi</h3>
                            <ul class="list-unstyled mt-2">
                                <li class="mb-2"><i class="fas fa-check-circle text-primary-blue me-2"></i> Membangun
                                    kerjasama dengan pihak terkait</li>
                                <li class="mb-2"><i class="fas fa-check-circle text-primary-blue me-2"></i> Menyediakan
                                    fasilitas terbaik</li>
                                <li class="mb-2"><i class="fas fa-check-circle text-primary-blue me-2"></i> Menyediakan
                                    Kendaraan terbaik</li>
                                <li class="mb-2"><i class="fas fa-check-circle text-primary-blue me-2"></i> Memberikan
                                    pelayanan prima</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- PRODUK & LAYANAN -->
        <section id="produk-layanan" class="py-5">
            <div class="container">
                <div class="text-center mb-5">
                    <h2 class="section-title">Produk & Layanan</h2>
                    <p class="text-muted w-75 mx-auto">Solusi lengkap kebutuhan operasional dan proyek Anda</p>
                </div>
                <div class="row g-4">
                    <div class="col-md-6 col-lg-3">
                        <div class="produk-item">
                            <div class="produk-icon mx-auto"><i
                                    class="fas fa-charging-station fa-3x text-primary-blue"></i></div>
                            <h3 class="h5 fw-bold">Mobil Listrik</h3>
