---
import { FontAwesomeIcon } from "astro-fontawesome";
import {
    faTimes,
    faHome,
    faChevronRight,
    faBuilding,
    faTruck,
    faImages,
    faHandshake,
    faHeadset
} from "@fortawesome/free-solid-svg-icons";
import {
    faWhatsapp,
    faInstagram,
    faLinkedinIn
} from "@fortawesome/free-brands-svg-icons";
---

<div class="mobile-nav-overlay" id="mobileNavOverlay">
    <div class="mobile-nav-header">
        <div class="brand-info">
            <img
                src="/image/logo.webp"
                alt="Logo"
                width="66"
                height="38"
                onerror="this.setAttribute('src', 'https://placehold.co/66x38/2563eb/white?text=PLK')"
            />
            <span>PESONA LINTANG<br />KEMUKUS</span>
        </div>
        <button
            class="mobile-nav-close"
            id="mobileNavClose"
            aria-label="Tutup Menu"><FontAwesomeIcon icon={faTimes} /></button
        >
    </div>
    <div class="mobile-nav-links">
        <a href="#home" class="mobile-nav-link" data-section="home"
            ><span class="nav-icon"><FontAwesomeIcon icon={faHome} /></span>Beranda<FontAwesomeIcon
                icon={faChevronRight} class="nav-arrow" /></a
        >
        <a href="#profil" class="mobile-nav-link" data-section="profil"
            ><span class="nav-icon"><FontAwesomeIcon icon={faBuilding} /></span>Profil
            Perusahaan<FontAwesomeIcon icon={faChevronRight} class="nav-arrow" /></a
        >
        <a
            href="#produk-layanan"
            class="mobile-nav-link"
            data-section="produk-layanan"
            ><span class="nav-icon"><FontAwesomeIcon icon={faTruck} /></span>Produk &
            Layanan<FontAwesomeIcon icon={faChevronRight} class="nav-arrow" /></a
        >
        <a href="#galeri" class="mobile-nav-link" data-section="galeri"
            ><span class="nav-icon"><FontAwesomeIcon icon={faImages} /></span>Galeri<FontAwesomeIcon
                icon={faChevronRight} class="nav-arrow" /></a
        >
        <a href="#mitra" class="mobile-nav-link" data-section="mitra"
            ><span class="nav-icon"><FontAwesomeIcon icon={faHandshake} /></span
            >Partner & Support<FontAwesomeIcon icon={faChevronRight} class="nav-arrow" /></a
        >
        <a href="#support" class="mobile-nav-link" data-section="support"
            ><span class="nav-icon"><FontAwesomeIcon icon={faHeadset} /></span
            >Support<FontAwesomeIcon icon={faChevronRight} class="nav-arrow" /></a
        >
    </div>
    <div class="mobile-nav-footer">
        <a
            href="https://wa.me/6285156262804?text=Halo%20PT%20Pesona%20Lintang%20Kemukus%2C%20saya%20ingin%20menanyakan%20sewa%20kendaraan"
            class="btn-cta"
            id="mobileCta"><FontAwesomeIcon icon={faWhatsapp} /> Hubungi Kami</a
        >
        <div class="social-row">
            <a
                href="https://www.instagram.com/pesonalintangkemukus/"
                class="text-primary-blue me-3 fs-5"
                aria-label="Instagram"><FontAwesomeIcon icon={faInstagram} /></a
            >
            <a
                href="https://www.linkedin.com/in/pt-pesona-lintang-kemukus-197165270/"
                class="text-primary-blue me-3 fs-5"
                aria-label="LinkedIn"><FontAwesomeIcon icon={faLinkedinIn} /></a
            >
        </div>
    </div>
</div>
