---
import { FontAwesomeIcon } from "astro-fontawesome";
import {
    faTimes,
    faChevronLeft,
    faChevronRight
} from "@fortawesome/free-solid-svg-icons";
---

<div class="galeri-lightbox" id="galeriLightbox">
    <div class="lightbox-inner">
        <button
            class="lightbox-close"
            id="lightboxClose"
            aria-label="Tutup Galeri"><FontAwesomeIcon icon={faTimes} /></button
        >
        <button
            class="lightbox-nav-btn lightbox-prev"
            id="lightboxPrev"
            aria-label="Sebelumnya"><FontAwesomeIcon icon={faChevronLeft} /></button
        >
        <button
            class="lightbox-nav-btn lightbox-next"
            id="lightboxNext"
            aria-label="Berikutnya"><FontAwesomeIcon icon={faChevronRight} /></button
        >
        <img loading="lazy" id="lightboxImg" src="" alt="" />
        <div class="lightbox-caption">
            <p id="lightboxTitle" class="h5-style m-0"></p>
            <p id="lightboxDesc" class="m-0"></p>
        </div>
    </div>
</div>
