---
import { FontAwesomeIcon } from "astro-fontawesome";
import {
    faMapMarkerAlt,
    faEnvelope
} from "@fortawesome/free-solid-svg-icons";
import {
    faWhatsapp,
    faInstagram,
    faLinkedin,
    faTiktok
} from "@fortawesome/free-brands-svg-icons";
---

<footer class="footer pt-5 pb-4">
    <div class="container">
        <div class="row">
            <div class="col-md-5 mb-4">
                <img
                    loading="lazy"
                    src="/image/logo.webp"
                    alt="Logo"
                    width="87"
                    height="50"
                    style="height: 50px; margin-bottom: 1rem;"
                />
                <h3 class="h4 text-primary-blue">PT Pesona Lintang Kemukus</h3>
                <p>
                    Solusi sewa kendaraan & alat berat untuk korporasi dan
                    industri nasional.
                </p>
                <div>
                    <FontAwesomeIcon icon={faMapMarkerAlt} class="me-2 text-primary-blue" /> Mensana
                    Tower Lantai 6 Unit K, Jalan Raya Kranggan No. 69, Jatisampurna,
                    Kota Bekasi, Jawa Barat 17433.
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <h3 class="h5 text-white">Tautan Cepat</h3>
                <ul class="list-unstyled">
                    <li>
                        <a
                            href="#home"
                            class="text-decoration-none text-secondary"
                            >Beranda</a
                        >
                    </li>
                    <li>
                        <a
                            href="#profil"
                            class="text-decoration-none text-secondary"
                            >Profil Perusahaan</a
                        >
                    </li>
                    <li>
                        <a
                            href="#produk-layanan"
                            class="text-decoration-none text-secondary"
                            >Produk & Layanan</a
                        >
                    </li>
                    <li>
                        <a
                            href="#galeri"
                            class="text-decoration-none text-secondary"
                            >Galeri</a
                        >
                    </li>
                    <li>
                        <a
                            href="#mitra"
                            class="text-decoration-none text-secondary"
                            >Partner</a
                        >
                    </li>
                    <li>
                        <a
                            href="#support"
                            class="text-decoration-none text-secondary"
                            >Support</a
                        >
                    </li>
                </ul>
            </div>
            <div class="col-md-4 mb-4">
                <h3 class="h5 text-white">Hubungi Kami</h3>
                <p>
                    <FontAwesomeIcon icon={faWhatsapp} class="me-2 text-primary-blue" /> +62 813
                    3179 5070<br />
                    <FontAwesomeIcon icon={faEnvelope} class="me-2 text-primary-blue" /> cs@pesonalintangkemukus.com<br
                    />
                    <div class="mt-3">
                        <a
                            href="https://www.instagram.com/pesonalintangkemukus/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-primary-blue me-3 fs-5 text-decoration-none"
                            aria-label="Instagram"
                        >
                            <FontAwesomeIcon icon={faInstagram} />
                        </a>
                        <a
                            href="https://www.linkedin.com/in/pt-pesona-lintang-kemukus-197165270/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-primary-blue me-3 fs-5 text-decoration-none"
                            aria-label="LinkedIn"
                        >
                            <FontAwesomeIcon icon={faLinkedin} />
                        </a>
                        <a
                            href="https://www.tiktok.com/@petakus.2gd"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-primary-blue me-3 fs-5 text-decoration-none"
                            aria-label="TikTok"
                        >
                            <FontAwesomeIcon icon={faTiktok} />
                        </a>
                    </div>
                </p>
            </div>
            <hr class="opacity-25" />
            <div class="text-center small">
                © 2026 PT Pesona Lintang Kemukus — Solusi Sewa Kendaraan & Alat
                Berat Corporate & Tol
            </div>
        </div>
    </div>
</footer>
