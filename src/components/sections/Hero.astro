---
import { FontAwesomeIcon } from "astro-fontawesome";
import {
    faChevronLeft,
    faChevronRight,
    faVolumeMute,
    faVolumeUp
} from "@fortawesome/free-solid-svg-icons";
---

<section id="home" class="hero-section">
    <video
        class="hero-video-background"
        autoplay
        loop
        playsinline
        muted
        id="heroVideo"
        preload="none"
    >
        <source src="/video/bg2.mp4" type="video/mp4" />
        <track kind="captions" src="" srclang="id" label="Indonesian" />
    </video>
    <div class="sound-indicator" id="soundIndicator">
        <div class="sound-badge">
            <span id="soundIconWrapper">
                <FontAwesomeIcon icon={faVolumeMute} class="sound-icon-mute" />
                <FontAwesomeIcon icon={faVolumeUp} class="sound-icon-up" style="display: none;" />
            </span>
            <span id="soundText">Suara Mati</span>
        </div>
    </div>
    <div class="swiper hero-swiper">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <div class="hero-slide">
                    <div class="container py-5 my-4">
                        <div class="row align-items-center min-vh-75">
                            <div class="col-lg-7 text-white mb-5 mb-lg-0">
                                <h1
                                    class="display-4 fw-bold mb-4 slide-content"
                                >
                                    Your Best <span style="color: #60a5fa;"
                                        >Rent Car</span
                                    > Services
                                </h1>
                                <p
                                    class="lead mb-4 opacity-90 slide-content"
                                    style="animation-delay: 0.1s;"
                                >
                                    PT Pesona Lintang Kemukus (PETAKUS)
                                    merupakan perusahaan yg bergerak di bidang
                                    penyedia jasa sewa kendaraan besar maupun
                                    kecil yg dikhususkan utk corporate.
                                </p>
                            </div>
                            <div class="col-lg-5 text-center">
                                <div class="hero-logo-wrapper">
                                    <img
                                        src="/image/logo.webp"
                                        alt="PT Pesona Lintang Kemukus"
                                        width="380"
                                        height="220"
                                        fetchpriority="high"
                                    />
                                </div>
                                <div class="hero-caption">
                                    <p class="h5-style">
                                        Corporate Cars Specialist
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="swiper-slide">
                <div class="hero-slide">
                    <div class="container py-5 my-4">
                        <div
                            class="row align-items-center min-vh-75 justify-content-center text-center"
                        >
                            <div class="col-lg-8 text-white">
                                <div class="hero-logo-wrapper mb-4">
                                    <img
                                        src="/image/logo.webp"
                                        alt="PT Pesona Lintang Kemukus"
                                        style="max-width: 200px;"
                                        width="200"
                                        height="116"
                                    />
                                </div>
                                <div class="slide-content">
                                    <h1 class="slogan-text">
                                        "DRIVING YOUR BUSINESS FORWARD,
                                        TOGETHER"
                                    </h1>
                                    <div class="hero-caption">
                                        <p class="h5-style">
                                            #KamiAdaUntukAnda
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="hero-swiper-button-prev" aria-label="Previous slide">
            <FontAwesomeIcon icon={faChevronLeft} />
        </div>
        <div class="hero-swiper-button-next" aria-label="Next slide">
            <FontAwesomeIcon icon={faChevronRight} />
        </div>
        <div class="hero-pagination">
            <div class="dot" data-index="0"></div>
            <div class="dot" data-index="1"></div>
        </div>
    </div>
</section>
