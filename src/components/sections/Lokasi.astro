<section id="lokasi" class="py-5 bg-soft-blue">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-5" data-aos="fade-right">
                <h2 class="section-title">Lokasi Operasional</h2>
                <p class="lead">
                    Kami hadir di Pulau Jawa, Sumatra, dan Kalimantan.
                </p>
                <div class="mt-4">
                    <div class="d-flex align-items-center mb-3">
                        <i
                            class="fas fa-map-marker-alt text-primary-blue fa-2x me-3"
                        ></i>
                        <div>
                            <strong>Kantor Pusat</strong><br />Mensana Tower
                            Lantai 6 Unit K, Jalan Raya Kranggan No. 69,
                            Jatisampurna, Kota Bekasi, Jawa Barat 17433
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-7 mt-4 mt-lg-0" data-aos="fade-left">
                <div class="bg-white p-3 rounded-4 shadow">
