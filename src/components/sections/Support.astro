<section id="support" class="support-section py-6">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h2 class="section-title">Layanan Support 24/7</h2>
            <p class="text-muted">
                Kami siap membantu kapanpun Anda membutuhkan
            </p>
        </div>
        <div class="row g-5 text-center">
            <div class="col-lg-4" data-aos="fade-up">
                <div class="support-item">
                    <div class="icon-wrapper">
                        <i class="fas fa-headset"></i>
                    </div>
                    <h3 class="h4">Call Center 24 Jam</h3>
                    <p>
                        Layanan darurat dan bantuan teknis tersedia setiap saat.
                    </p>
                </div>
            </div>
            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
                <div class="support-item">
                    <div class="icon-wrapper">
                        <i class="fas fa-tools"></i>
                    </div>
                    <h4>Tim Teknis Siaga</h4>
                    <p>
                        Teknisi berpengalaman siap turun ke lapangan untuk
                        perawatan dan perbaikan.
                    </p><span class="badge-soft">Response 24 Jam</span>
                </div>
            </div>
            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
                <div class="support-item">
                    <div class="icon-wrapper">
                        <i class="fas fa-exchange-alt"></i>
                    </div>
                    <h4>Penggantian Unit Cepat</h4>
                    <p>
                        Jika terjadi kendala, kami siap mengganti unit dengan
                        armada pengganti.
                    </p><span class="badge-soft primary">Garansi 24 Jam</span>
                </div>
            </div>
        </div>
    </div>
</section>
