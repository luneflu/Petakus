---
import { FontAwesomeIcon } from "astro-fontawesome";
import {
    faCheckCircle,
    faEye,
    faBullseye
} from "@fortawesome/free-solid-svg-icons";
---

<section id="profil" class="py-5 bg-soft-blue">
    <div class="container py-4">
        <div class="row g-5 align-items-center mb-5">
            <div class="col-lg-6" data-aos="fade-right">
                <h2 class="section-title mt-3 fs-1">
                    PT Pesona Lintang Kemukus
                </h2>
                <p class="mt-3 fs-5 text-secondary">
                    PT Pesona Lintang Kemukus hadir sbg mitra terpercaya yg
                    profesional dlm menyediakan kendaraan operasional yg
                    dikhususkan utk perusahaan, dg standar layanan terbaik di
                    seluruh wilayah Indonesia. Kami berkomitmen utk mendukung
                    efisiensi operasional perusahaan Anda melalui penyediaan
                    armada yg prima, sys manajemen transportasi yg terintegrasi,
                    serta dukungan layanan yg terbaik.
                </p>
                <div class="row mt-4">
                    <div class="col-md-6 mb-3">
                        <FontAwesomeIcon
                            icon={faCheckCircle}
                            class="text-primary-blue me-2"
                            aria-hidden="true" /> 500+ Unit Kendaraan & Alat Berat
                    </div>
                    <div class="col-md-6 mb-3">
                        <FontAwesomeIcon
                            icon={faCheckCircle}
                            class="text-primary-blue me-2"
                            aria-hidden="true" /> 100+ Mitra Corporate Aktif
                    </div>
                    <div class="col-md-6 mb-3">
                        <FontAwesomeIcon
                            icon={faCheckCircle}
                            class="text-primary-blue me-2"
                            aria-hidden="true" /> 24/7 Emergency Support
                    </div>
                    <div class="col-md-6 mb-3">
                        <FontAwesomeIcon
                            icon={faCheckCircle}
                            class="text-primary-blue me-2"
                            aria-hidden="true" /> ISO & K3 Bersertifikat
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mb-4">
            <h2 class="section-title">Visi & Misi</h2>
            <p class="text-muted">Komitmen kami utk menjadi mitra terpercaya</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6" data-aos="fade-right">
                <div class="visi-misi-card h-100 shadow-sm">
                    <FontAwesomeIcon icon={faEye} class="fa-3x text-primary-blue mb-3" />
                    <h3 class="fw-bold">Visi</h3>
                    <p class="fs-5">Penyambung akses membangun Indonesia</p>
                </div>
            </div>
            <div class="col-md-6" data-aos="fade-left">
                <div class="visi-misi-card h-100 shadow-sm">
                    <FontAwesomeIcon icon={faBullseye} class="fa-3x text-primary-blue mb-3" />
                    <h3 class="fw-bold">Misi</h3>
                    <ul class="list-unstyled mt-2">
                        <li class="mb-2">
                            <FontAwesomeIcon
                                icon={faCheckCircle}
                                class="text-primary-blue me-2"
                                aria-hidden="true" /> Membangun kerjasama dg pihak
                            terkait
                        </li>
                        <li class="mb-2">
                            <FontAwesomeIcon
                                icon={faCheckCircle}
                                class="text-primary-blue me-2"
                                aria-hidden="true" /> Menyediakan fasilitas terbaik
                        </li>
                        <li class="mb-2">
                            <FontAwesomeIcon
                                icon={faCheckCircle}
                                class="text-primary-blue me-2"
                                aria-hidden="true" /> Menyediakan Kendaraan terbaik
                        </li>
                        <li class="mb-2">
                            <FontAwesomeIcon
                                icon={faCheckCircle}
                                class="text-primary-blue me-2"
                                aria-hidden="true" /> Memberikan pelayanan prima
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
