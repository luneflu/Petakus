---

<section id="galeri" class="py-5 bg-soft-blue">
    <div class="container-fluid px-0">
        <div class="text-center mb-4" data-aos="fade-up">
            <h2 class="section-title">Galeri Kendaraan</h2>
            <p class="text-muted mt-3">Koleksi kendaraan unggulan kami</p>
        </div>
        <div class="galeri-tabs" data-aos="fade-up" data-aos-delay="80">
            <button class="galeri-tab-btn active" data-filter="tol"
                ><i class="fas fa-road"></i> Kendaraan Layanan Jalan Tol</button
            >
            <button class="galeri-tab-btn" data-filter="ev"
                ><i class="fas fa-charging-station"></i> Mobil Listrik</button
            >
            <button class="galeri-tab-btn" data-filter="kecil"
                ><i class="fas fa-car"></i> Kendaraan Kecil</button
            >
            <button class="galeri-tab-btn" data-filter="besar"
                ><i class="fas fa-truck"></i> Kendaraan Besar</button
            >
        </div>
        <div class="galeri-grid" data-aos="fade-up" data-aos-delay="150">
            {
                galeriData.map((item) => (
                    <div
                        class="galeri-item"
                        data-category={item.category}
                        data-title={item.dataTitle || item.title}
                        data-desc={item.dataDesc || item.desc}
                    >
                        <img
                            loading="lazy"
                            src={item.imgSrc}
                            alt={item.imgAlt || item.title}
                            width={item.imgWidth || "600"}
                            height={item.imgHeight || "450"}
                        />
                        <div class="galeri-item-overlay">
                            <span class="item-badge">{item.badge}</span>
                            <p class="item-title">
                                {item.overrideOverlayTitle || item.title}
                            </p>
                            <p class="item-desc">{item.desc}</p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
