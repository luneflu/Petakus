---
import ProdukItem from "../ui/ProdukItem.astro";
import { FontAwesomeIcon } from "astro-fontawesome";
import {
    faChargingStation,
    faCar,
    faTruck,
    faHardHat,
    faArrowRight
} from "@fortawesome/free-solid-svg-icons";

const produkData = [
    {
        icon: faChargingStation,
        title: "Mobil Listrik",
        desc: "Ramah lingkungan, efisien, teknologi modern",
    },
    {
        icon: faCar,
        title: "Kendaraan Kecil",
        desc: "Sedan, SUV, MPV utk mobilitas eksekutif",
    },
    {
        icon: faTruck,
        title: "Kendaraan Besar",
        desc: "Bus, truk box, tronton utk logistik",
    },
    {
        icon: faHardHat,
        title: "Alat Berat",
        desc: "Excavator, bulldozer, crane utk proyek tol",
    },
];
---

<section id="produk-layanan" class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Produk & Layanan</h2>
            <p class="text-muted w-75 mx-auto">
                Solusi lengkap kebutuhan operasional & proyek Anda
            </p>
        </div>
        <div class="row g-4">
            {
                produkData.map((item) => (
                    <ProdukItem
                        icon={item.icon}
                        title={item.title}
                        desc={item.desc}
                    />
                ))
            }
        </div>
        <div class="text-center mt-5">
            <a href="#kontak" class="btn btn-primary-blue"
                >Konsultasi Kebutuhan <FontAwesomeIcon icon={faArrowRight} class="ms-2" /></a
            >
        </div>
    </div>
</section>
